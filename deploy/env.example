# /etc/circuit/env  (chmod 600, owned by root; read by systemd)

# Port the Node process listens on (127.0.0.1 only; nginx proxies to it).
PORT=8797

# HMAC key for the session cookie. Required in production. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Shared reviewer credential. Required; the server refuses logins while either is empty.
GATE_USER=change-me
GATE_PASS=change-me

# AI review. Set AI_PROVIDER to anthropic, gemini, or none. AI_MODEL is chosen by the benchmark (bench/results).
AI_PROVIDER=none
AI_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Abuse limits for the public URL: per-session calls per hour and process-wide calls per UTC day.
AI_HOURLY_LIMIT=30
AI_DAILY_CAP=500

# Optional: reported by /healthz. deploy.sh sets this from git.
COMMIT_SHA=
