  "mutations": [
    {
      "id": "remove_power_source",
      "label": "What if there is no battery?",
      "description": "Deletes the battery instance and clears the power source. The project becomes incomplete and voltage-dependent rules stop evaluating.",
      "ops": [
        {
          "op": "clear_power_source"
        },
        {
          "op": "remove_instance",
          "instance": "battery"
        }
      ],
      "expected": [
        {
          "ruleId": "power_source_present",
          "severity": "violation",
          "category": "power"
        }
      ],
      "expectStatus": "incomplete"
    },
    {
      "id": "split_driver_reference",
      "label": "What if the driver's ground is broken?",
      "description": "Moves the driver GND pin onto its own net. The driver still receives 5 V and control signals but shares no reference with the XIAO.",
      "ops": [
        {
          "op": "move_pin",
          "instance": "driver",
          "pin": "GND",
          "net": "GND_DRIVER_ONLY"
        }
      ],
      "expected": [
        {
          "ruleId": "signal_reference",
          "severity": "violation",
          "category": "reference",
          "affectedInstance": "driver"
        }
      ]
    },
    {
      "id": "force_stby_low",
      "label": "What if STBY is tied to ground?",
      "description": "Moves the driver STBY pin from the XIAO GPIO to GND. The driver is held in standby.",
      "ops": [
        {
          "op": "move_pin",
          "instance": "driver",
          "pin": "STBY",
          "net": "GND"
        }
      ],
      "expected": [
        {
          "ruleId": "driver_enable_state",
          "severity": "violation",
          "category": "control_state",
          "affectedInstance": "driver"
        }
      ]
    },
    {
      "id": "disconnect_stby",
      "label": "What if STBY is left unconnected?",
      "description": "Disconnects STBY entirely. On this exact Adafruit breakout the 10 kOhm pull-up keeps the driver enabled, so no finding is expected.",
      "ops": [
        {
          "op": "move_pin",
          "instance": "driver",
          "pin": "STBY",
          "net": null
        }
      ],
      "expected": [],
      "expectAbsent": [
        "driver_enable_state"
      ]
    },
    {
      "id": "connect_motor_to_mcu",
      "label": "What if a motor is wired to a GPIO?",
