  "optimizations": [
    {
      "id": "right_size_battery",
      "title": "Right-size the battery for the runtime target",
      "goal": "15 to 30 minute runtime with the smallest, lightest pack that meets it",
      "summary": "Swaps the 1000-1500 mAh 3S class for a 200-300 mAh 3S class. Same voltage window, same protection, about a quarter of the mass.",
      "ops": [
        {
          "op": "swap_registry",
          "instance": "battery",
          "registryId": "battery.3s_lipo_200_300mah_class"
        },
        {
          "op": "set_assumption",
          "key": "battery_class",
          "value": "3S LiPo, 200-300 mAh"
        }
      ],
      "acceptsRisks": [
        "Less reserve if the average-current assumption is optimistic"
      ],
      "costDirection": "lower",
      "expected": [],
      "expectAbsent": [
        "runtime_estimate"
      ],
      "expectNoNewViolations": true
    },
    {
      "id": "motors_at_rated_voltage",
      "title": "Run the motors at their rated 6 V",
      "goal": "Top speed and torque the motors are rated for",
      "summary": "Raises the motor rail to 6 V and adds a second LM2596 module set to 5 V for the XIAO, so the logic supply stays inside its range.",
      "ops": [
        {
          "op": "add_instance",
          "id": "buck_logic",
          "registryId": "regulator.lm2596_adjustable_module_common",
          "label": "LM2596 for logic (5 V)",
          "props": {
            "outputV": {
              "value": 5.0,
              "provenance": "user"
            }
          }
        },
        {
          "op": "move_pin",
          "instance": "buck_logic",
          "pin": "IN+",
          "net": "VIN_PROT"
        },
        {
          "op": "move_pin",
          "instance": "buck_logic",
          "pin": "IN-",
          "net": "GND"
        },
        {
          "op": "move_pin",
          "instance": "buck_logic",
          "pin": "OUT-",
          "net": "GND"
        },
        {
          "op": "move_pin",
          "instance": "buck_logic",
          "pin": "OUT+",
          "net": "RAIL_5V_LOGIC",
          "name": "5V logic",
          "kind": "power"
        },
        {
          "op": "move_pin",
          "instance": "mcu",
          "pin": "5V",
          "net": "RAIL_5V_LOGIC"
