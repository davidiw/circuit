    {
      "id": "remove_reverse_polarity_diode",
      "label": "Remove reverse-polarity protection",
      "description": "Deletes the diode and wires the battery straight into the buck. The circuit still runs; the reverse-polarity strategy is gone.",
      "ops": [
        {
          "op": "remove_instance",
          "instance": "diode"
        },
        {
          "op": "move_pin",
          "instance": "buck",
          "pin": "IN+",
          "net": "BATT_PLUS"
        }
      ],
      "expected": [
        {
          "ruleId": "reverse_polarity_strategy",
          "severity": "warning",
          "category": "protection",
          "affectedInstance": "battery"
        }
      ]
    },
    {
      "id": "remove_bulk_capacitance",
      "label": "Remove the bulk capacitor",
      "description": "Deletes the 470 uF capacitor from the 5 V rail. Heuristic rule; expect a warning, not a failure.",
      "ops": [
        {
          "op": "remove_instance",
          "instance": "bulk_cap"
        }
      ],
      "expected": [
        {
          "ruleId": "bulk_capacitance",
          "severity": "warning",
          "category": "transients",
          "affectedInstance": "driver"
