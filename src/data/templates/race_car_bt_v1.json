          "pin": "M-",
          "net": "MCU_DRIVE_2"
        },
        {
          "op": "move_pin",
          "instance": "mcu",
          "pin": "D8",
          "net": "MCU_DRIVE_2"
        }
      ],
      "expected": [
        {
          "ruleId": "motor_load_path",
          "severity": "violation",
          "category": "load_path",
          "affectedInstance": "motor_left"
        }
      ]
    },
    {
