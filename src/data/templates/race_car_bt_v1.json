    {
      "id": "swap_battery_2s",
      "label": "What if the battery is 2S?",
      "description": "Uses the handoff's original 2S class. With the series diode, the buck sees about 5.95 V at end of discharge for a 5 V output.",
      "ops": [
        {
          "op": "swap_registry",
