  "assumptions": [
    {
      "key": "battery_class",
      "value": "3S LiPo, 1000-1500 mAh",
      "reason": "3S instead of the handoff's 2S: with a series Schottky and a 5 V LM2596 output, 2S leaves under 1 V of regulator headroom at end of discharge. 3S keeps about 4 V. Exact pack and connector deferred.",
      "source": "template",
      "status": "active"
    },
    {
      "key": "reverse_polarity_strategy",
      "value": "series 1N5822 Schottky before the buck",
      "reason": "Simple, through-hole, protects the buck and everything downstream; costs about 0.45 V that 3S can afford",
      "source": "template",
      "status": "active"
    },
    {
      "key": "motor_rail_v",
      "value": 5.0,
      "reason": "One buck output feeds both the XIAO 5V input and the driver motor rail. Motors are 6 V nominal, so this trades roughly 17 percent top speed for one regulator.",
      "source": "template",
      "status": "active"
    },
    {
      "key": "motor_bulk_cap_uf",
      "value": 470,
      "reason": "Heuristic bulk capacitance on the shared 5 V rail to soften motor start and stall transients. Not a component-spec invariant.",
      "source": "template",
      "status": "active"
    },
    {
      "key": "avg_motor_current_a",
      "value": 0.25,
      "reason": "Per motor, averaged over a mixed drive cycle at about 40 percent duty. Runtime estimate depends on this.",
      "source": "template",
      "status": "active"
    },
    {
      "key": "mcu_avg_current_a",
      "value": 0.12,
      "reason": "XIAO ESP32-S3 with BLE active, no Wi-Fi",
      "source": "template",
      "status": "active"
    },
    {
      "key": "buck_efficiency",
      "value": 0.85,
      "reason": "Typical for an LM2596 module at this ratio and load",
      "source": "template",
      "status": "active"
    },
    {
      "key": "gpio_assignment",
      "value": "D0-D5 to PWMA, AIN1, AIN2, PWMB, BIN1, BIN2; D6 to STBY",
      "reason": "Arbitrary; any PWM-capable XIAO GPIO works",
      "source": "template",
      "status": "active"
    }
  ],
